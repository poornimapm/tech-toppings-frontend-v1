# Copy to .env for local development:  copy .env.example .env   (never commit .env)
#
# VITE_* values are embedded in the browser bundle at build time: put NOTHING secret here.
# Everything has a safe default (src/core/config/env.ts); set only what you want to change.

# ---------------------------------------------------------------- browser-visible
VITE_APP_NAME=Tech-Toppings
# Base path of the API as seen by the browser. Always same-origin: the dev server and the
# production host proxy /api to the backend (keeps auth cookies first-party).
VITE_API_BASE_URL=/api
# After this long without a health response, show "Waking up the server…" (free hosting
# sleeps after 15 min idle and takes ~1 min to start).
VITE_WAKE_THRESHOLD_MS=3000
# Give up (show "Unreachable" + retry button) after this long.
VITE_WAKE_MAX_WAIT_MS=90000
# Re-check API health this often while the app is open.
VITE_HEALTH_POLL_MS=60000

# ---------------------------------------------------------------- dev/preview server only
# Backend the /api proxy forwards to (vite dev and vite preview).
DEV_API_PROXY_TARGET=http://localhost:8000
DEV_SERVER_PORT=5173
PREVIEW_SERVER_PORT=4173

# ---------------------------------------------------------------- tooling
# Source for `npm run gen:api` (file path or URL). Default: the backend repo's openapi.json
# produced by `poe openapi` in ../tech-toppings-backend-v1.
# OPENAPI_SOURCE=../tech-toppings-backend-v1/openapi.json
